{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.git",
			"!**/dist",
			"!editors/obsidian/main.js",
			"!editors/jetbrains/build",
			"!editors/jetbrains/.gradle",
			"!editors/jetbrains/.kotlin",
			"!editors/jetbrains/.intellijPlatform",
			"!test/fixtures"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noControlCharactersInRegex": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
