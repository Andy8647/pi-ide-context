{
	"name": "pi-ide-context",
	"version": "0.5.1",
	"description": "/ide for pi — connect Neovim, VS Code or Obsidian and inject the file, cursor and selection into every prompt",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"neovim",
		"vscode",
		"obsidian",
		"ide",
		"editor-context",
		"context-injection"
	],
	"author": "Andy8647",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Andy8647/pi-ide-context.git"
	},
	"homepage": "https://github.com/Andy8647/pi-ide-context#readme",
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"image": "https://raw.githubusercontent.com/Andy8647/pi-ide-context/main/assets/cover.png"
	},
	"files": [
		"src/",
		"lua/",
		"plugin/",
		"docs/",
		"README.md"
	],
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/*.test.ts\"",
		"typecheck:vscode": "cd editors/vscode && npm run typecheck",
		"typecheck:obsidian": "cd editors/obsidian && npm run typecheck",
		"fmt": "biome format --write .",
		"fmt:check": "biome format --check .",
		"verify": "npm run lint && npm run typecheck && npm test && npm run typecheck:vscode && npm run typecheck:obsidian",
		"pack:check": "npm pack --dry-run",
		"prepublishOnly": "npm run verify && npm run pack:check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@earendil-works/pi-coding-agent": "^0.84.4",
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0"
	}
}
